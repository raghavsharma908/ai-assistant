def ui_toggle_history():
    """Slides open or collapses the sidebar history drawer on demand."""
    global sidebar_visible
    
    if sidebar_visible:
        # Hide Sidebar
        sidebar_frame.grid_forget()
        sidebar_visible = False
    else:
        # Show Sidebar
        sidebar_frame.grid(row=0, column=0, sticky="ns")
        ui_refresh_history_list()
        sidebar_visible = True

def ui_refresh_history_list():
    """Queries DB and renders all past conversations in the sidebar, handling empty state."""
    # Clear the old list in the scroll frame
    for widget in history_scroll_frame.winfo_children():
        widget.destroy()
        
    conversations = db_get_conversations()
    
    # Handle empty database case
    if not conversations:
        empty_lbl = tk.Label(
            history_scroll_frame,
            text="No history yet",
            bg=COLOR_BG_DARK,
            fg=COLOR_MUTED,
            font=("Segoe UI", 11, "italic"),
            pady=20
        )
        empty_lbl.pack(fill="x", padx=10)
        return
        
    # Render conversations list
    for conv in conversations:
        conv_id = conv["id"]
        title = conv["title"]
        
        # Single item container frame
        item_frame = tk.Frame(history_scroll_frame, bg=COLOR_BG_DARK, pady=2)
        item_frame.pack(fill="x", pady=4)
        item_frame.columnconfigure(0, weight=1)
        
        # Style active conversation differently
        is_active = (conv_id == current_conversation_id)
        bg_col = COLOR_BG_HEADER if is_active else COLOR_BG_DARK
        fg_col = COLOR_ACCENT if is_active else COLOR_FG_LIGHT
        
        # Clicking this frame/button loads history
        btn = tk.Button(
            item_frame,
            text=f"💬 {title}",
            bg=bg_col,
            fg=fg_col,
            activebackground=COLOR_BG_HEADER,
            activeforeground=COLOR_ACCENT,
            font=("Segoe UI", 10),
            anchor="w",
            bd=0,
            padx=10,
            pady=8,
            cursor="hand2",
            justify="left",
            wraplength=190,
            command=lambda cid=conv_id: ui_load_conversation(cid)
        )
        btn.grid(row=0, column=0, sticky="ew")
        
        # Visual hover feedback
        btn.bind("<Enter>", lambda e, b=btn: b.configure(bg=COLOR_BG_HEADER) if current_conversation_id != conv_id else None)
        btn.bind("<Leave>", lambda e, b=btn, cid=conv_id: b.configure(bg=COLOR_BG_DARK) if current_conversation_id != cid else None)
        
        # Mini Delete Button next to history item
        del_btn = tk.Button(
            item_frame,
            text="✕",
            bg=bg_col,
            fg=COLOR_MUTED,
            activebackground=COLOR_BG_HEADER,
            activeforeground="#ff757f",
            font=("Segoe UI", 9, "bold"),
            bd=0,
            padx=8,
            cursor="hand2",
            command=lambda cid=conv_id: ui_delete_conversation(cid)
        )
        del_btn.grid(row=0, column=1, sticky="ns")

def ui_delete_conversation(conv_id):
    """Deletes a past conversation directly from the sidebar UI and DB."""
    global current_conversation_id
    
    if messagebox.askyesno("Delete History", "Are you sure you want to delete this conversation?"):
        db_delete_conversation(conv_id)
        # Reset UI if current active conv was deleted
        if current_conversation_id == conv_id:
            ui_new_conversation()
        else:
            ui_refresh_history_list()

def ui_new_conversation():
    """Clears the chat display screen and initializes a new thread session."""
    global current_conversation_id
    
    current_conversation_id = None
    
    # Clear message bubble display
    for widget in chat_scroll_frame.winfo_children():
        widget.destroy()
        
    # Set default welcoming state
    welcome_lbl = tk.Label(
        chat_scroll_frame,
        text="Start typing below to begin a new conversation.\nYour chat will be saved automatically!",
        bg=COLOR_BG_MAIN,
        fg=COLOR_MUTED,
        font=("Segoe UI", 11, "italic"),
        pady=100
    )
    welcome_lbl.pack(fill="both", expand=True)
    
    # Clear text entry focus
    message_entry.delete(0, tk.END)
    
    if sidebar_visible:
        ui_refresh_history_list()

def ui_load_conversation(conv_id):
    """Loads all historical messages of a specific conversation from SQLite into the chat area."""
    global current_conversation_id
    
    current_conversation_id = conv_id
    
    # Clear existing widgets
    for widget in chat_scroll_frame.winfo_children():
        widget.destroy()
        
    # Fetch messages
    messages = db_get_messages(conv_id)
    for msg in messages:
        ui_display_message(msg["sender"], msg["text"])
        
    # Refresh sidebar highlight
    if sidebar_visible:
        ui_refresh_history_list()
        
    # Auto scroll to bottom
    chat_canvas.update_idletasks()
    chat_canvas.yview_moveto(1.0)

def ui_display_message(sender, text):
    """Renders a single premium chat message bubble in the scrollable viewport."""
    # Outer bubble row container
    bubble_row = tk.Frame(chat_scroll_frame, bg=COLOR_BG_MAIN, pady=6)
    bubble_row.pack(fill="x", expand=True)
    
    # Distinguish alignments & background colors
    is_user = (sender.lower() == "user")
    align_side = "e" if is_user else "w"
    bg_color = COLOR_BUBBLE_USER if is_user else COLOR_BUBBLE_AI
    fg_color = "#ffffff" if is_user else COLOR_FG_LIGHT
    
    # Sub-frame container for bubble block + metadata header
    block_frame = tk.Frame(bubble_row, bg=COLOR_BG_MAIN)
    block_frame.pack(side="right" if is_user else "left", padx=10)
    
    # Sender name header
    lbl_sender = tk.Label(
        block_frame,
        text=sender.upper(),
        bg=COLOR_BG_MAIN,
        fg=COLOR_MUTED,
        font=("Segoe UI", 8, "bold")
    )
    lbl_sender.pack(anchor="ne" if is_user else "nw", pady=(0, 2))
    
    # Styled Message Bubble Card
    bubble_card = tk.Frame(block_frame, bg=bg_color, padx=14, pady=10)
    bubble_card.pack(anchor="ne" if is_user else "nw")
    
    # Wrapped Text Content
    msg_label = tk.Label(
        bubble_card,
        text=text,
        bg=bg_color,
        fg=fg_color,
        font=("Segoe UI", 11),
        wraplength=480,
        justify="left",
        anchor="w"
    )
    msg_label.pack()

def ui_send_message():
    """Takes user text, initiates conversation in DB if needed, saves message, and displays AI response."""
    global current_conversation_id
    
    user_text = message_entry.get().strip()
    if not user_text:
        return
        
    # Clear welcoming label if starting fresh
    if current_conversation_id is None:
        for widget in chat_scroll_frame.winfo_children():
            widget.destroy()
            
    # 1. Create a new conversation thread record if first message
    if current_conversation_id is None:
        # Create an intelligent short title (max 25 chars) from the first sentence
        conv_title = user_text[:25] + "..." if len(user_text) > 25 else user_text
        current_conversation_id = db_create_conversation(conv_title)
        
    # 2. Display User message in UI
    ui_display_message("User", user_text)
    
    # 3. Save User message to SQLite DB
    db_save_message(current_conversation_id, "User", user_text)
    
    # Clear Entry widget immediately
    message_entry.delete(0, tk.END)
    
    # Auto scroll down to user's bubble
    chat_canvas.update_idletasks()
    chat_canvas.yview_moveto(1.0)
    
    # 4. Generate AI mock response
    ai_text = ai_get_response(user_text)
    
    # 5. Display and save AI mock response
    ui_display_message("AI", ai_text)
    db_save_message(current_conversation_id, "AI", ai_text)
    
    # Refresh sidebar drawer list in background
    if sidebar_visible:
        ui_refresh_history_list()
        
    # Final auto scroll down to AI's bubble
    chat_canvas.update_idletasks()
    chat_canvas.yview_moveto(1.0)


