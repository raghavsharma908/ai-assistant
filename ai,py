def ai_get_response(user_input):
    """Simulates an intelligent, friendly AI response based on the user's input."""
    input_lower = user_input.lower().strip()
    
    greetings = ["hello", "hi", "hey", "greetings", "hola", "yo"]
    if any(g in input_lower for g in greetings):
        return random.choice([
            "Hello! I am your AI assistant. How can I help you today?",
            "Hi there! What can I do for you today?",
            "Hey! Great to connect with you. Ask me anything!"
        ])
        
    coding = ["code", "python", "program", "function", "bug", "write", "tkinter"]
    if any(c in input_lower for c in coding):
        return random.choice([
            "I love programming! Python is extremely powerful for building clean desktop interfaces and database systems.",
            "Writing clean, modular code with small separate functions makes debugging and review so much easier!",
            "Need help writing a script? Let me know the specific requirements and we can draft it together."
        ])
        
    db_keywords = ["database", "sqlite", "sql", "history", "save", "save conversation", "table"]
    if any(k in input_lower for k in db_keywords):
        return (
            "We are using a local SQLite database (`chat_history.db`) to persist your discussions. "
            "Each message you send is linked to a conversation thread, making it easy to toggle and review history later."
        )
        
    question_words = ["what", "how", "why", "who", "where", "when", "?"]
    if any(q in input_lower for q in question_words):
        return random.choice([
            "That's an interesting question. Let me break down the answer for you. To achieve this, we can structure our logic into small, modular steps.",
            "I'm simulated here locally, but in a real-world setting, I'd connect to a powerful large language model to give you deep analytical answers!",
            "I'd suggest breaking that problem down into isolated subcomponents. What part would you like to explore first?"
        ])
        
    return random.choice([
        f"Interesting! You said: '{user_input}'. Tell me more about that or let me know how I can assist further.",
        "I am here to assist you. Feel free to ask about Python, GUI development, SQLite integration, or any other topic!",
        "Understood. I am processing that information. Let me know if there's anything specific you'd like to do next."
    ])


