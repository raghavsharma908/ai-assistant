def enable_high_dpi():
    """Enables process DPI awareness for crisp text rendering on high-DPI Windows screens."""
    try:
        from ctypes import windll
        windll.shcore.SetProcessDpiAwareness(1)
    except Exception:
        pass

def ui_init():
    """Initializes and returns the Tkinter root window with core setup."""
    enable_high_dpi()
    root = tk.Tk()
    root.title("AI Chat Assistant")
    root.geometry("950x650")
    root.configure(bg=COLOR_BG_MAIN)
    # Allow resizing
    root.columnconfigure(0, weight=1)
    root.rowconfigure(0, weight=1)
    return root

def ui_configure_styles():
    """Configures the ttk widget style mapping for modern aesthetics."""
    style = ttk.Style()
    style.theme_use("clam")
    
    # Global frame styling
    style.configure("TFrame", background=COLOR_BG_MAIN)
    
    # Custom scrollbar styling
    style.configure(
        "Modern.Vertical.TScrollbar",
        background=COLOR_BG_HEADER,
        troughcolor=COLOR_BG_MAIN,
        bordercolor=COLOR_BG_MAIN,
        arrowcolor=COLOR_FG_LIGHT,
        relief="flat"
    )
    style.map(
        "Modern.Vertical.TScrollbar",
        background=[("active", COLOR_BUBBLE_AI)]
    )


