def main():
    """Main execution entry point coordinating app setup and start."""
    # Initialize DB Layer
    db_init()
    
    # Initialize Window
    root = ui_init()
    
    # Apply Visual Styles
    ui_configure_styles()
    
    # Build core grid layout panels
    ui_create_main_layout(root)
    
    # Build Header toolbar
    ui_create_header_widgets(main_frame)
    
    # Build Scrollable chat bubble view
    ui_create_chat_area_widgets(main_frame)
    
    # Build Bottom text entry bar
    ui_create_footer_widgets(main_frame)
    
    # Build Sidebar history panels
    ui_create_sidebar_widgets(sidebar_frame)
    
    # Initialize screen visual contents
    ui_new_conversation()
    
    # Start main event loop
    root.mainloop()

if __name__ == "__main__":
    main()
