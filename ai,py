# 6. CANVAS & SCROLLING BINDING HANDLERS
# ==============================================================================

def on_canvas_configure(event, canvas_window):
    """Updates the scroll frame width to match the canvas size during window resize."""
    chat_canvas.itemconfig(canvas_window, width=event.width)

def on_frame_configure(event):
    """Resets the scrollable region box size of the canvas to fit contents."""
    chat_canvas.configure(scrollregion=chat_canvas.bbox("all"))

def on_mousewheel(event):
    """Processes mouse scrolling horizontally or vertically anywhere over the window."""
    chat_canvas.yview_scroll(int(-1 * (event.delta / 120)), "units")


